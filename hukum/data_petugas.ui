<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Form</class>
 <widget class="QWidget" name="Form">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Data Petugas</string>
  </property>

  <!-- ================= STYLE FINAL ================= -->
  <property name="styleSheet">
   <string>
/* ================= GLOBAL ================= */
QWidget {
    background-color: #f2f2f2;
    font-family: Arial;
    font-size: 11px;
    color: #000000;
}

/* ================= JUDUL ================= */
QLabel#lblJudul {
    font-size: 18px;
    font-weight: bold;
    color: #000000;
}

/* ================= LABEL ================= */
QLabel {
    color: #000000;
    font-weight: bold;
}

/* ================= GROUP BOX ================= */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    margin-top: 15px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
}

/* ================= INPUT ================= */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #a0a0a0;
    border-radius: 4px;
    padding: 4px;
    color: #000000;
}

/* ================= BUTTON ================= */
QPushButton {
    background-color: #e6e6e6;
    border: 1px solid #8a8a8a;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: bold;
    color: #000000;
}

QPushButton:hover {
    background-color: #dcdcdc;
}

QPushButton:pressed {
    background-color: #cfcfcf;
}

/* ================= TABLE ================= */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #c0c0c0;
}

QHeaderView::section {
    background-color: #e0e0e0;
    border: 1px solid #b0b0b0;
    padding: 4px;
    font-weight: bold;
}
   </string>
  </property>

  <!-- ================= LAYOUT ================= -->
  <layout class="QVBoxLayout">

   <!-- JUDUL -->
   <item>
    <widget class="QLabel" name="lblJudul">
     <property name="text">
      <string>ENTRY DATA PETUGAS</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
    </widget>
   </item>

   <!-- FORM -->
   <item>
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>INPUT DATA</string>
     </property>
     <layout class="QGridLayout">

      <item row="0" column="0">
       <widget class="QLabel">
        <property name="text">
         <string>ID ADMIN</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="txtId"/>
      </item>

      <item row="0" column="2">
       <widget class="QLabel">
        <property name="text">
         <string>NAMA ADMIN</string>
        </property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="txtNama"/>
      </item>

      <item row="1" column="0">
       <widget class="QLabel">
        <property name="text">
         <string>USERNAME</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="txtUser"/>
      </item>

      <item row="1" column="2">
       <widget class="QLabel">
        <property name="text">
         <string>PASSWORD</string>
        </property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="txtPass">
        <property name="echoMode">
         <enum>QLineEdit::Password</enum>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- TOMBOL -->
   <item>
    <layout class="QHBoxLayout">
     <item><widget class="QPushButton" name="btnSimpan"><property name="text"><string>SIMPAN</string></property></widget></item>
     <item><widget class="QPushButton" name="btnUbah"><property name="text"><string>UBAH</string></property></widget></item>
     <item><widget class="QPushButton" name="btnHapus"><property name="text"><string>HAPUS</string></property></widget></item>
     <item><widget class="QPushButton" name="btnBersih"><property name="text"><string>BERSIH</string></property></widget></item>
     <item><widget class="QPushButton" name="btnKeluar"><property name="text"><string>KELUAR</string></property></widget></item>
    </layout>
   </item>

   <!-- TABEL -->
   <item>
    <widget class="QTableWidget" name="tablePetugas">
     <property name="columnCount">
      <number>4</number>
     </property>
     <column><property name="text"><string>ID</string></property></column>
     <column><property name="text"><string>Nama</string></property></column>
     <column><property name="text"><string>Username</string></property></column>
     <column><property name="text"><string>Password</string></property></column>
    </widget>
   </item>

  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
