/* ================= GLOBAL ================= */
QWidget {
    background-color: #f2f2f2;
    font-family: Arial;
    font-size: 11px;
    color: #000000;
}

/* ================= LABEL ================= */
QLabel {
    color: #000000;
}

/* ================= BUTTON ================= */
QPushButton {
    background-color: #e6e6e6;
    border: 1px solid #8a8a8a;
    border-radius: 4px;
    padding: 5px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #dcdcdc;
}

QPushButton:pressed {
    background-color: #cfcfcf;
}

/* ================= COMBOBOX ================= */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #a0a0a0;
    padding: 4px;
}

/* ================= TABLE ================= */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #c0c0c0;
}

QHeaderView::section {
    background-color: #e0e0e0;
    border: 1px solid #b0b0b0;
    padding: 4px;
    font-weight: bold;
}

/* ================= HEADER FRAME ================= */
QFrame#frameHeader {
    background-color: #e0e0e0;
}
